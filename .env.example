# ==============================================================================
# CONFIGURACIÓN DE CREDENCIALES Y OBJETIVO (DEVSECOPS & OPSEC)
# ==============================================================================
# NUNCA subas el archivo .env con credenciales reales a un repositorio.
# Copia este archivo a '.env' y completa con tus valores para pruebas locales.

# Cuenta secundaria/monitoreo (Recomendado usar cuenta bot/burner para OPSEC)
IG_USERNAME=tu_usuario_instagram
IG_PASSWORD=tu_contraseña_instagram

# Cuenta pública objetivo a monitorear (sin el @)
TARGET_ACCOUNT=cuenta_objetivo_a_monitorear

# (OPCIONAL pero ALTAMENTE RECOMENDADO para GitHub Actions):
# Sesión exportada en Base64 para evitar bloqueos por login desde IPs de centros de datos.
# Generar localmente ejecutando: python tracker.py --export-session
IG_SESSION_BASE64=

# (OPCIONAL) Notificaciones instantáneas por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (OPCIONAL) Notificaciones por WhatsApp (CallMeBot)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

